# ──────────────────────────────────────────────────────
# projetinho-inf-postgres-exporter — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ──────────────────────────────────────────────────────

# ── Conexão ao Postgres ───────────────────────────────
# Role dedicada com permissões mínimas (somente SELECT em catálogo do sistema).
# Crie com: psql -f sql/create_metrics_role.sql
DATA_SOURCE_PASS=change_me

# Host do Postgres na rede Docker interna
PG_HOST=postgres
PG_PORT=5432

# DSN completo — montado a partir das vars acima pelo docker-compose
# Não edite manualmente; é construído no compose.
# DATA_SOURCE_NAME=postgresql://metrics_reader:${DATA_SOURCE_PASS}@${PG_HOST}:${PG_PORT}/postgres?sslmode=require

# ── Porta de exposição ────────────────────────────────
# Acessível apenas internamente; Prometheus faz scrape nesta porta.
METRICS_PORT=9187

# ── Log ───────────────────────────────────────────────
# debug, info, warn, error
LOG_LEVEL=info
